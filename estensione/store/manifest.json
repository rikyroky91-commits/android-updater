{
  "manifest_version": 3,
  "name": "__MSG_nome__",
  "version": "0.8.0",
  "description": "__MSG_descrizione__",
  "default_locale": "en",
  "action": {
    "default_title": "__MSG_titolo__"
  },
  "background": {
    "service_worker": "sfondo.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "opzioni.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icone/16.png",
    "48": "icone/48.png",
    "128": "icone/128.png"
  }
}
